#---Database (Supabase, schema "auth")---#
DATABASE_URL=postgresql://username:password@host:5432/postgres
# Schema de Supabase donde vive este servicio (compartido con otros microservicios).
DB_SCHEMA=auth

#---JWT---#
# Obligatoria, de 32 caracteres o más (el servicio no arranca si falta o es este valor de ejemplo).
# Generar con: openssl rand -base64 48. El orquestador usa la misma para validar los tokens.
JWT_SECRET=cambiar-por-una-clave-secreta-larga-y-aleatoria
JWT_ALGORITHM=HS256
# Minutos de vida del access token (por defecto 15).
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
# Días de vida del refresh token.
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

#---límite de intentos de login (por email)---#
# Tras LOGIN_MAX_INTENTOS fallos seguidos dentro de LOGIN_VENTANA_MINUTOS hay que esperar
# LOGIN_BLOQUEO_MINUTOS antes de volver a probar (responde 429 con Retry-After).
LOGIN_MAX_INTENTOS=5
LOGIN_VENTANA_MINUTOS=5
LOGIN_BLOQUEO_MINUTOS=5

#---frontend---#
FRONTEND_LIST=["http://localhost:5173"]

#---seed (solo desarrollo: crea un ADMIN si no existe al arrancar)---#
# Dejar vacío para no sembrar ningún usuario.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
